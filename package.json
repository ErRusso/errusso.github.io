{
  "name": "simone-russo-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "cv": "bun run build && bun run cv:build",
    "cv:build": "bun scripts/build-cv.mjs",
    "now:sync": "node scripts/sync-now.mjs",
    "lighthouse:sync": "node scripts/lighthouse-sync.mjs",
    "deploy:prepare": "bun run now:sync && bun run typecheck && bun run build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
}
